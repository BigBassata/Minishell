{
    ignore_libreadline
    Memcheck:Leak
    ...
    obj:/libreadline.so.
}

{
	readlines_still_reachable
	Memcheck:Leak
	match-leak-kinds: reachable
	...
	fun:readline
}

{
	add_history_still_reachable
	Memcheck:Leak
	match-leak-kinds: reachable
	...
	fun:add_history
}

{
    usrbin
    Memcheck:Leak
    ...
    obj:/usr/bin/*
}